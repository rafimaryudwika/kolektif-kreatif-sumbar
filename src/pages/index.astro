---
import Layout from '../layouts/Layout.astro';
import { checkHealth } from '../lib/cognodb';

// Rendered per request so the status below always reflects the live database.
const health = await checkHealth();
---

<Layout title="SumbuKolektif — Sumbar Creative Network">
  <main id="main" class="mx-auto flex min-h-dvh max-w-3xl flex-col justify-center px-6 py-16">
    <p class="text-sm font-medium tracking-widest text-ink-subtle uppercase">
      Sumbar Creative Network
    </p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
      SumbuKolektif
    </h1>
    <p class="mt-4 max-w-prose text-lg text-pretty text-ink-muted">
      Mapping how filmmakers, designers, animators, musicians and make-up artists
      across West Sumatra are actually connected — through the projects,
      agencies and collectives they share.
    </p>

    <div class="mt-10 rounded-xl border border-border bg-surface p-5">
      <div class="flex items-center gap-3">
        <span
          class:list={[
            'size-2.5 shrink-0 rounded-full',
            health.ok ? 'bg-project' : 'bg-skill',
          ]}
          aria-hidden="true"
        ></span>
        <h2 class="text-sm font-semibold">
          {health.ok ? 'Connected to CognoDB' : 'Graph database unreachable'}
        </h2>
      </div>
      <p class="mt-2 text-sm text-ink-muted">
        {
          health.ok
            ? `${health.agent} over Bolt ${health.protocolVersion}.`
            : 'The explorer will show cached guidance until the connection returns.'
        }
      </p>
    </div>

    <ul class="mt-10 flex flex-wrap gap-2" aria-label="Entity types in the graph">
      {
        [
          ['Talent', 'bg-talent'],
          ['Project', 'bg-project'],
          ['Agency', 'bg-agency'],
          ['Skill', 'bg-skill'],
          ['Collective', 'bg-collective'],
        ].map(([label, dot]) => (
          <li class="flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1.5 text-sm text-ink-muted">
            <span class:list={['size-2 rounded-full', dot]} aria-hidden="true" />
            {label}
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
