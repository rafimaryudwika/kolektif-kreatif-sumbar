---
/**
 * The explorer. Rendered per request like everything else, but the graph itself
 * is fetched from `/api/graph` by the island rather than embedded in the HTML:
 * the layout engine needs `window`, so it cannot run on the server, and shipping
 * the payload twice would only make first paint heavier.
 */
import Layout from '../layouts/Layout.astro';
import Explorer from '../components/Explorer.svelte';

const LEGEND = [
  ['Talent', 'bg-talent'],
  ['Project', 'bg-project'],
  ['Agency', 'bg-agency'],
  ['Skill', 'bg-skill'],
  ['Collective', 'bg-collective'],
] as const;
---

<Layout title="Explore the network — SumbuKolektif">
  <div class="flex h-dvh flex-col">
    <header
      class="flex shrink-0 flex-wrap items-center justify-between gap-x-6 gap-y-3 border-b border-border px-4 py-3"
    >
      <div class="flex items-baseline gap-3">
        <a href="/" class="text-sm font-semibold tracking-tight">SumbuKolektif</a>
        <span class="text-sm text-ink-subtle">Network explorer</span>
      </div>

      <ul class="flex flex-wrap gap-x-4 gap-y-1.5" aria-label="Entity types">
        {
          LEGEND.map(([label, dot]) => (
            <li class="flex items-center gap-1.5 text-xs text-ink-muted">
              <span class:list={['size-2 rounded-full', dot]} aria-hidden="true" />
              {label}
            </li>
          ))
        }
      </ul>
    </header>

    <main id="main" class="flex min-h-0 flex-1 flex-col">
      {/*
        `client:only` renders nothing on the server, so without a fallback the
        first paint is an empty frame under the header — no sidebar, no search,
        nothing to say the page is working. The slot is server-rendered and
        replaced on hydration.
      */}
      <Explorer client:only="svelte">
        <div slot="fallback" class="grid flex-1 place-items-center px-6">
          <p class="text-sm text-ink-muted" role="status">Starting the explorer…</p>
        </div>
      </Explorer>
    </main>
  </div>
</Layout>
